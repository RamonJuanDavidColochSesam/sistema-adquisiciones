{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GuateCompras: portal web (Edge)",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://127.0.0.1:8080/sistema-adquisiciones/portal.html?v=20261009",
      "webRoot": "${workspaceFolder}/src/main/webapp",
      "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "preLaunchTask": "GuateCompras: iniciar backend"
    },
    {
      "name": "GuateCompras: portal web (servidor ya corriendo)",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://127.0.0.1:8080/sistema-adquisiciones/portal.html?v=20261009",
      "webRoot": "${workspaceFolder}/src/main/webapp",
      "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"
    },
    {
      "name": "GuateCompras: depurar WPF",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "GuateCompras: compilar WPF",
      "program": "${workspaceFolder}/desktop/GuateCompras.Desktop/bin/Release/net10.0-windows/GuateCompras.Desktop.dll",
      "cwd": "${workspaceFolder}/desktop/GuateCompras.Desktop",
      "env": {
        "GUATECOMPRAS_API_URL": "http://127.0.0.1:8080/sistema-adquisiciones/api/"
      }
    }
  ]
}
