<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>GuateCompras • Informe académico 7 • Datos SQL Server</Description>
  <DataSources>
    <DataSource Name="GuateComprasSQL">
      <DataSourceReference>/GuateCompras/GuateComprasSQL</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Datos">
      <Query>
        <DataSourceName>GuateComprasSQL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Desde">
            <Value>=Parameters!Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Hasta">
            <Value>=Parameters!Hasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COUNT(*) AS ordenes_adjudicadas,AVG(CAST(DATEDIFF(DAY,o.fecha_creacion,a.fecha_resolucion) AS DECIMAL(10,2))) AS promedio_dias FROM Adjudicacion a JOIN OrdenCompra o ON o.id_orden=a.id_orden WHERE a.fecha_resolucion BETWEEN @Desde AND @Hasta</CommandText>
      </Query>
      <Fields>
        <Field Name="ordenes_adjudicadas">
          <DataField>ordenes_adjudicadas</DataField>
        </Field>
        <Field Name="promedio_dias">
          <DataField>promedio_dias</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Desde">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateAdd("yyyy",-1,Today())</Value>
        </Values>
      </DefaultValue>
      <Prompt>Desde</Prompt>
    </ReportParameter>
    <ReportParameter Name="Hasta">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Hasta</Prompt>
    </ReportParameter>
  </ReportParameters>
