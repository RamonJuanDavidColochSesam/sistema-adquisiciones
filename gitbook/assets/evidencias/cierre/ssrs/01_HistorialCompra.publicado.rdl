<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>GuateCompras • Informe académico 1 • Datos SQL Server</Description>
  <DataSources>
    <DataSource Name="GuateComprasSQL">
      <DataSourceReference>/GuateCompras/GuateComprasSQL</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Datos">
      <Query>
        <DataSourceName>GuateComprasSQL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Articulo">
            <Value>=Parameters!Articulo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Desde">
            <Value>=Parameters!Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Hasta">
            <Value>=Parameters!Hasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT ar.codigo_articulo,ar.nombre AS articulo,v.nombre_comercial AS proveedor,a.fecha_resolucion,d.cantidad_final,d.precio_acordado,CAST(d.cantidad_final*d.precio_acordado AS DECIMAL(18,2)) AS monto FROM DetalleAdjudicacion d JOIN Adjudicacion a ON a.id_adjudicacion=d.id_adjudicacion JOIN Pedido p ON p.id_pedido=d.id_pedido JOIN Articulo ar ON ar.id_articulo=p.id_articulo JOIN Oferta f ON f.id_oferta=d.id_oferta JOIN Proveedor v ON v.id_proveedor=f.id_proveedor WHERE (@Articulo=0 OR ar.id_articulo=@Articulo) AND a.fecha_resolucion BETWEEN @Desde AND @Hasta  ORDER BY ar.nombre,a.fecha_resolucion,v.nombre_comercial</CommandText>
      </Query>
      <Fields>
        <Field Name="codigo_articulo">
          <DataField>codigo_articulo</DataField>
        </Field>
        <Field Name="articulo">
          <DataField>articulo</DataField>
        </Field>
        <Field Name="proveedor">
          <DataField>proveedor</DataField>
        </Field>
        <Field Name="fecha_resolucion">
          <DataField>fecha_resolucion</DataField>
        </Field>
        <Field Name="cantidad_final">
          <DataField>cantidad_final</DataField>
        </Field>
        <Field Name="precio_acordado">
          <DataField>precio_acordado</DataField>
        </Field>
        <Field Name="monto">
          <DataField>monto</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Articulo">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>0</Value>
        </Values>
      </DefaultValue>
      <Prompt>Articulo</Prompt>
    </ReportParameter>
    <ReportParameter Name="Desde">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateAdd("yyyy",-1,Today())</Value>
        </Values>
      </DefaultValue>
      <Prompt>Desde</Prompt>
    </ReportParameter>
    <ReportParameter Name="Hasta">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Hasta</Prompt>
    </ReportParameter>
  </ReportParameters>
