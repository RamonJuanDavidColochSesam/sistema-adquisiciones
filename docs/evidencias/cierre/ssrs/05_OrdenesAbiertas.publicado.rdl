  <DataSets>
    <DataSet Name="Datos">
      <Query>
        <DataSourceName>GuateComprasSQL</DataSourceName>
        <CommandText>SELECT o.* FROM vw_OrdenesAbiertas o WHERE 1=1  ORDER BY o.fecha_limite_oferta,o.id_orden</CommandText>
      </Query>
      <Fields>
        <Field Name="id_orden">
          <DataField>id_orden</DataField>
        </Field>
        <Field Name="descripcion">
