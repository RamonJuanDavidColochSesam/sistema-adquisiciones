<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>GuateCompras • Informe académico 2 • Datos SQL Server</Description>
  <DataSources>
    <DataSource Name="GuateComprasSQL">
      <DataSourceReference>/GuateCompras/GuateComprasSQL</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Datos">
      <Query>
        <DataSourceName>GuateComprasSQL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Desde">
            <Value>=Parameters!Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Hasta">
            <Value>=Parameters!Hasta.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP(5) v.codigo_proveedor,v.nombre_comercial AS proveedor,SUM(CAST(d.cantidad_final*d.precio_acordado AS DECIMAL(18,2))) AS monto_adjudicado,COUNT(DISTINCT a.id_orden) AS ordenes FROM DetalleAdjudicacion d JOIN Adjudicacion a ON a.id_adjudicacion=d.id_adjudicacion JOIN Oferta f ON f.id_oferta=d.id_oferta JOIN Proveedor v ON v.id_proveedor=f.id_proveedor WHERE a.fecha_resolucion BETWEEN @Desde AND @Hasta  GROUP BY v.codigo_proveedor,v.nombre_comercial ORDER BY monto_adjudicado DESC,v.codigo_proveedor</CommandText>
      </Query>
      <Fields>
        <Field Name="codigo_proveedor">
          <DataField>codigo_proveedor</DataField>
        </Field>
        <Field Name="proveedor">
          <DataField>proveedor</DataField>
        </Field>
        <Field Name="monto_adjudicado">
          <DataField>monto_adjudicado</DataField>
        </Field>
        <Field Name="ordenes">
          <DataField>ordenes</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Desde">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateAdd("yyyy",-1,Today())</Value>
        </Values>
      </DefaultValue>
      <Prompt>Desde</Prompt>
    </ReportParameter>
    <ReportParameter Name="Hasta">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Hasta</Prompt>
    </ReportParameter>
  </ReportParameters>
