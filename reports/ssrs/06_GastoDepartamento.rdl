<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>GuateCompras • Informe académico 6 • Datos SQL Server</Description>
  <DataSources>
    <DataSource Name="GuateComprasSQL">
      <DataSourceReference>/GuateCompras/GuateComprasSQL</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Datos">
      <Query>
        <DataSourceName>GuateComprasSQL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Sucursal">
            <Value>=Parameters!Sucursal.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@InicioAnio">
            <Value>=DateSerial(Parameters!Anio.Value,1,1)</Value>
          </QueryParameter>
          <QueryParameter Name="@FinAnio">
            <Value>=DateSerial(Parameters!Anio.Value+1,1,1)</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT s.codigo_sucursal,s.ciudad,de.nombre AS departamento,SUM(CAST(d.cantidad_final*d.precio_acordado AS DECIMAL(18,2))) AS gasto FROM DetalleAdjudicacion d JOIN Adjudicacion a ON a.id_adjudicacion=d.id_adjudicacion JOIN Pedido p ON p.id_pedido=d.id_pedido JOIN Departamento de ON de.id_departamento=p.id_departamento JOIN Sucursal s ON s.id_sucursal=de.id_sucursal WHERE (@Sucursal=0 OR s.id_sucursal=@Sucursal) AND a.fecha_resolucion&gt;=@InicioAnio AND a.fecha_resolucion&lt;@FinAnio GROUP BY s.codigo_sucursal,s.ciudad,de.nombre ORDER BY s.codigo_sucursal,de.nombre</CommandText>
      </Query>
      <Fields>
        <Field Name="codigo_sucursal">
          <DataField>codigo_sucursal</DataField>
        </Field>
        <Field Name="ciudad">
          <DataField>ciudad</DataField>
        </Field>
        <Field Name="departamento">
          <DataField>departamento</DataField>
        </Field>
        <Field Name="gasto">
          <DataField>gasto</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Sucursal">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>0</Value>
        </Values>
      </DefaultValue>
      <Prompt>Sucursal</Prompt>
    </ReportParameter>
    <ReportParameter Name="Anio">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>=Year(Today())</Value>
        </Values>
      </DefaultValue>
      <Prompt>Anio</Prompt>
    </ReportParameter>
  </ReportParameters>
