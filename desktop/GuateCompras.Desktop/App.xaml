<Application x:Class="GuateCompras.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Navy" Color="#12344C"/><SolidColorBrush x:Key="Teal" Color="#087E83"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#F4F7FA"/><Setter Property="Foreground" Value="#20364A"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="{StaticResource Teal}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="BorderBrush" Value="#CBD7DF"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8EE"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5"/><Setter Property="AlternatingRowBackground" Value="#FAFCFD"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/></Style>
 </Application.Resources>
</Application>
