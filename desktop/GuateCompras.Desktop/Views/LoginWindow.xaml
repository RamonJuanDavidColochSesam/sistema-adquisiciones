<Window x:Class="GuateCompras.Desktop.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GuateCompras · Iniciar sesión" Width="520" Height="580" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#12344C">
 <Border Background="White" CornerRadius="14" Margin="35" Padding="32">
  <StackPanel><TextBlock Text="GuateCompras" FontSize="29" FontWeight="SemiBold" Foreground="#087E83"/><TextBlock Text="GESTIÓN INSTITUCIONAL" FontSize="10" Foreground="#6C7D8D" Margin="0,8,0,22"/><TextBlock Text="Acceda a su espacio de trabajo" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
   <TextBlock Text="Servidor de la institución" FontSize="12"/><TextBox x:Name="ServerUrl" FontSize="11"/>
   <TextBlock Text="Usuario" FontSize="12"/><TextBox x:Name="Username" MaxLength="30"/>
   <TextBlock Text="Contraseña" FontSize="12"/><PasswordBox x:Name="Password" Padding="9" Margin="0,5,0,18" MaxLength="128"/>
   <Button x:Name="LoginButton" Content="Iniciar sesión" Click="Login_Click" IsDefault="True"/>
   <TextBlock x:Name="ErrorText" Foreground="#AC313A" TextWrapping="Wrap" FontSize="12" Margin="0,15"/>
  </StackPanel>
 </Border>
</Window>
