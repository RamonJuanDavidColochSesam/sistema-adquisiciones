<Window x:Class="GuateCompras.Desktop.Views.ReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GuateCompras · Informes institucionales" Width="1200" Height="780" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/>
   <WrapPanel>
    <StackPanel Width="120" Margin="0,0,12,0"><TextBlock Text="Artículo (ID; 0=todos)"/><TextBox x:Name="Article" Text="0"/></StackPanel>
    <StackPanel Width="120" Margin="0,0,12,0"><TextBlock Text="Proveedor (ID)"/><TextBox x:Name="Provider" Text="0"/></StackPanel>
    <StackPanel Width="120" Margin="0,0,12,0"><TextBlock Text="Orden (ID)"/><TextBox x:Name="Order" Text="0"/></StackPanel>
    <StackPanel Width="120" Margin="0,0,12,0"><TextBlock Text="Sucursal (ID)"/><TextBox x:Name="Branch" Text="0"/></StackPanel>
    <StackPanel Width="90" Margin="0,0,12,0"><TextBlock Text="Año"/><TextBox x:Name="Year"/></StackPanel>
    <StackPanel Width="150" Margin="0,0,12,0"><TextBlock Text="Desde"/><DatePicker x:Name="From" Margin="0,5,0,12"/></StackPanel>
    <StackPanel Width="150"><TextBlock Text="Hasta"/><DatePicker x:Name="To" Margin="0,5,0,12"/></StackPanel>
   </WrapPanel>
   <StackPanel Orientation="Horizontal" Margin="0,10,0,15"><Button x:Name="QueryButton" Content="Consultar informe" Click="Query_Click"/><Button Content="Exportar CSV" Click="Export_Click" Background="#EDF2F6" Foreground="#20364A"/><Button x:Name="SsrsButton" Content="Abrir informe en SSRS" Click="Ssrs_Click"/><TextBlock x:Name="SsrsStatus" VerticalAlignment="Center" Foreground="#6C7D8D" FontSize="11" Margin="12,0"/></StackPanel>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" TextWrapping="Wrap" Margin="0,15" Foreground="#536D7D"/>
  <DataGrid x:Name="ResultsGrid" AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
 </DockPanel>
</Window>
