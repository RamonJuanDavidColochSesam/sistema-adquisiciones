<Window x:Class="GuateCompras.Desktop.Views.WorkflowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="780" Height="800" WindowStartupLocation="CenterOwner">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <DockPanel Margin="28">
  <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorText" Foreground="#AC313A" TextWrapping="Wrap" Margin="0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Background="#EDF2F6" Foreground="#20364A"/><Button x:Name="SaveButton" Content="Confirmar operación completa" Click="Save_Click"/></StackPanel></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <StackPanel Visibility="{Binding Ordering,Converter={StaticResource BoolVisibility}}">
    <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
     <ContentControl Content="{Binding}"><ContentControl.Resources><DataTemplate x:Key="Text"><TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}"/></DataTemplate><DataTemplate x:Key="Select"><ComboBox ItemsSource="{Binding Choices}" SelectedValue="{Binding Text}" SelectedValuePath="Value" DisplayMemberPath="Label"/></DataTemplate><DataTemplate x:Key="Date"><DatePicker SelectedDate="{Binding Date}" Margin="0,5,0,12"/></DataTemplate></ContentControl.Resources><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="select"><Setter Property="ContentTemplate" Value="{StaticResource Select}"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="date"><Setter Property="ContentTemplate" Value="{StaticResource Date}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Solicitudes incluidas en la orden" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,10"/><ItemsControl ItemsSource="{Binding Pedidos}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" Padding="7" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
   <StackPanel Visibility="{Binding Awarding,Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="Fecha de resolución" FontSize="12" FontWeight="SemiBold"/><DatePicker SelectedDate="{Binding Resolution}" Margin="0,8,0,20"/><TextBlock Text="Observaciones"/><TextBox Text="{Binding Observations,UpdateSourceTrigger=PropertyChanged}" MaxLength="300"/>
    <ItemsControl ItemsSource="{Binding AwardLines}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DAE4EB" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,15"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,15"/><TextBlock Text="Oferta ganadora"/><ComboBox ItemsSource="{Binding Offers}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Offer}"/><TextBlock Text="Cantidad final"/><TextBox Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Precio acordado (Q)"/><TextBox Text="{Binding Price,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
