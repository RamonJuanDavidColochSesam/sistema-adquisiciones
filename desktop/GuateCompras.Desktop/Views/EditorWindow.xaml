<Window x:Class="GuateCompras.Desktop.Views.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:GuateCompras.Desktop.ViewModels" Title="{Binding Title}" Width="650" Height="760" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <DataTemplate x:Key="TextField"><TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" MaxLength="{Binding MaxLength}"/></DataTemplate>
  <DataTemplate x:Key="SelectField"><ComboBox ItemsSource="{Binding Choices}" SelectedValue="{Binding Text,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding Enabled}"/></DataTemplate>
  <DataTemplate x:Key="DateField"><DatePicker SelectedDate="{Binding Date}" Margin="0,5,0,12"/></DataTemplate>
  <DataTemplate x:Key="BooleanField"><CheckBox IsChecked="{Binding Checked}" IsEnabled="{Binding Enabled}" Content="Permitir" Margin="0,5,0,12"/></DataTemplate>
  <DataTemplate x:Key="PasswordField"><PasswordBox PasswordChanged="Password_Changed" MaxLength="72" Padding="9" Margin="0,5,0,12"/></DataTemplate>
 </Window.Resources>
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="GESTIÓN INSTITUCIONAL" FontSize="10" Foreground="#087E83"/><TextBlock Text="{Binding Title}" FontSize="25" Margin="0,10,0,20"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorText" Foreground="#AC313A" TextWrapping="Wrap" Margin="0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Background="#EDF2F6" Foreground="#20364A"/><Button x:Name="SaveButton" Content="Guardar cambios" Click="Save_Click" IsDefault="True"/></StackPanel></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/><ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource TextField}"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="select"><Setter Property="ContentTemplate" Value="{StaticResource SelectField}"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="date"><Setter Property="ContentTemplate" Value="{StaticResource DateField}"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="boolean"><Setter Property="ContentTemplate" Value="{StaticResource BooleanField}"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="password"><Setter Property="ContentTemplate" Value="{StaticResource PasswordField}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</Window>
